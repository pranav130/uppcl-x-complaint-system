# ==============================================================================
# Environment Configuration Template for UPPCL X Complaint System
# IMPORTANT: DO NOT commit actual secrets or credentials to version control.
# Copy this file to .env and fill in your authorized credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Official X API v2 Credentials (https://developer.x.com)
# ------------------------------------------------------------------------------
# App-only Bearer Token for reading recent public search posts
X_BEARER_TOKEN=your_x_bearer_token_here

# User context credentials for optional authorized reply posting (OAuth 1.0a or OAuth 2.0)
X_API_KEY=your_x_api_consumer_key_here
X_API_SECRET=your_x_api_consumer_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# ------------------------------------------------------------------------------
# 2. Google Sheets API Configuration
# ------------------------------------------------------------------------------
# Path to Google Cloud Service Account JSON file (recommended for headless background services)
GOOGLE_SERVICE_ACCOUNT_FILE=config/service_account.json

# Alternatively, OAuth2 client secrets if using user-delegated authorization
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=config/client_secrets.json

# Target Spreadsheet ID from URL:
# https://docs.google.com/spreadsheets/d/12smJ_xw3sRWPcCzDsh_hC44ac2NlpO9I_wDnXF-wFXU/edit
GOOGLE_SPREADSHEET_ID=12smJ_xw3sRWPcCzDsh_hC44ac2NlpO9I_wDnXF-wFXU
GOOGLE_SHEET_TAB_NAME="Twitter Complaint List"

# ------------------------------------------------------------------------------
# 3. Automation Operational Flags & Guardrails
# ------------------------------------------------------------------------------
# DRY_RUN: When true, discovers, classifies, routes, and drafts without modifying production or posting
DRY_RUN=true

# AUTO_POST_ENABLED: When false, all generated drafts require manual approval before posting
# DEFAULT MUST REMAIN FALSE
AUTO_POST_ENABLED=false

# EMERGENCY_STOP: Global kill-switch. When true, all polling, sync, and posting immediately halt
EMERGENCY_STOP=false

# DAILY_POST_CAP: Maximum number of public replies that may be published per calendar day
DAILY_POST_CAP=50

# POLLING_INTERVAL_MINUTES: Interval between polling cycles
POLLING_INTERVAL_MINUTES=5

# Checkpoint SQLite Database file path
SQLITE_DB_PATH=data/uppcl_monitor.db
